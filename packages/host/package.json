{
  "name": "@felyrics/host",
  "version": "0.0.0",
  "private": true,
  "description": "The host runtime: service invocation, the line protocol and the application path layout.",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@felyrics/toolchain": "*"
  }
}
