{
    "name": "@felyrics/lyricore",
    "version": "0.0.0",
    "private": true,
    "description": "Felyrics core lyrics data structures.",
    "main": "./out/main/index.js",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "node ./scripts/clean-out.mjs && tsc -p tsconfig.json",
        "test": "node --import ./tests/register.mjs --test --test-isolation=none \"tests/**/*.test.mjs\"",
        "test:watch": "node --import ./tests/register.mjs --test --test-isolation=none --watch \"tests/**/*.test.mjs\""
    },
    "types": "./out/main/index.d.ts",
    "type": "module"
}
