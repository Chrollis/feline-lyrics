{
    "name": "felyrics",
    "version": "0.0.0",
    "private": true,
    "description": "Feline-lyrics, lyrics timing and karaoke video composition.",
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write apps packages \"*.js\" \"*.json\" \"scripts/*.mjs\"",
        "format:check": "prettier --check apps packages \"*.js\" \"*.json\" \"scripts/*.mjs\"",
        "test": "npm test --workspaces --if-present",
        "test:services": "python\\python.exe -s -m pytest services/tests -q -p no:cacheprovider",
        "typecheck": "npm run typecheck --workspaces --if-present"
    },
    "license": "MPL-2.0",
    "type": "module",
    "packageManager": "npm@12.2.0",
    "engines": {
        "node": ">=22.18.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "typescript-eslint": "^8.71.1"
    }
}
